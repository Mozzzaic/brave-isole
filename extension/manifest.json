{
  "manifest_version": 3,
  "name": "Brave isolé — pont local",
  "version": "0.1.1",
  "description": "Onglets attribués aux assistants, pont natif local et arrêt visible.",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "tabGroups",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Brave isolé",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
